<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma fork — the Accept circle on the incoming-call screen. Yellow, not green: yellow is
     this fork's positive colour everywhere, and the button it replaces was already yellow. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/call_button_ripple">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/shiroikuma_call_yellow" />
        </shape>
    </item>
</ripple>
