<?xml version="1.0" encoding="utf-8"?>
<!--
  白い熊 fork: the black-yellow theme as an overlay, applied to every activity before it inflates
  anything (JamiApplication → SkTheme.onActivityPreCreated).

  It holds no colour value. Every colour attribute upstream's layouts and Material's widgets read
  is pointed at a role colour resource (@color/sk_role_…, sk_roles.xml), whose value comes from
  the role table at run time (cx.ring.sk.SkPalette). Buttons, switches, selection marks and menu
  rows are drawn in code from their roles (cx.ring.sk.SkViewInflater and friends); the styles
  below give them their shape only.
-->
<resources>
    <attr name="skDestructiveDialog" format="boolean" />

    <style name="ThemeOverlay.Sk" parent="">
        <item name="android:colorBackground">@color/sk_role_background</item>
        <item name="colorSurface">@color/sk_role_surface</item>
        <item name="colorOnSurface">@color/sk_role_text</item>
        <item name="colorOnBackground">@color/sk_role_text</item>
        <item name="colorSurfaceContainerLowest">@color/sk_role_surface</item>
        <item name="colorSurfaceContainerLow">@color/sk_role_surface</item>
        <item name="colorSurfaceContainer">@color/sk_role_surface</item>
        <item name="colorSurfaceContainerHigh">@color/sk_role_surface</item>
        <item name="colorSurfaceContainerHighest">@color/sk_role_surface</item>
        <item name="colorSurfaceBright">@color/sk_role_surface</item>
        <item name="colorSurfaceDim">@color/sk_role_surface</item>
        <item name="colorSurfaceVariant">@color/sk_role_surface</item>
        <item name="colorSurfaceInverse">@color/sk_role_accent</item>
        <item name="colorOnSurfaceInverse">@color/sk_role_on_accent</item>
        <item name="colorOnSurfaceVariant">@color/sk_role_text_secondary</item>
        <item name="colorPrimary">@color/sk_role_accent</item>
        <item name="colorPrimaryVariant">@color/sk_role_accent</item>
        <item name="colorPrimaryDark">@color/sk_role_background</item>
        <item name="colorPrimaryInverse">@color/sk_role_on_accent</item>
        <item name="colorSecondary">@color/sk_role_accent</item>
        <item name="colorSecondaryVariant">@color/sk_role_accent</item>
        <item name="colorTertiary">@color/sk_role_accent</item>
        <item name="colorAccent">@color/sk_role_accent</item>
        <item name="colorOnPrimary">@color/sk_role_on_accent</item>
        <item name="colorOnSecondary">@color/sk_role_on_accent</item>
        <item name="colorOnTertiary">@color/sk_role_on_accent</item>
        <item name="colorPrimaryContainer">@color/sk_role_list_selected</item>
        <item name="colorOnPrimaryContainer">@color/sk_role_list_selected_text</item>
        <item name="colorSecondaryContainer">@color/sk_role_list_selected</item>
        <item name="colorOnSecondaryContainer">@color/sk_role_list_selected_text</item>
        <item name="colorTertiaryContainer">@color/sk_role_list_selected</item>
        <item name="colorOnTertiaryContainer">@color/sk_role_list_selected_text</item>
        <item name="colorError">@color/sk_role_danger</item>
        <item name="colorOnError">@color/sk_role_on_accent</item>
        <item name="colorErrorContainer">@color/sk_role_background</item>
        <item name="colorOnErrorContainer">@color/sk_role_danger</item>
        <item name="colorOutline">@color/sk_role_outline</item>
        <item name="colorOutlineVariant">@color/sk_role_divider</item>
        <item name="colorControlNormal">@color/sk_role_icon</item>
        <item name="colorControlActivated">@color/sk_role_icon_active</item>
        <item name="colorControlHighlight">@color/sk_role_pressed</item>
        <item name="android:textColor">@color/sk_role_text</item>
        <item name="android:textColorPrimary">@color/sk_role_text</item>
        <item name="android:textColorSecondary">@color/sk_role_text_secondary</item>
        <item name="android:textColorTertiary">@color/sk_role_text_secondary</item>
        <item name="android:textColorHint">@color/sk_role_text_hint</item>
        <item name="android:textColorHighlight">@color/sk_role_text_selection</item>
        <item name="android:textColorLink">@color/sk_role_link</item>
        <item name="android:editTextColor">@color/sk_role_field_text</item>
        <item name="editTextColor">@color/sk_role_field_text</item>
        <item name="textColorAlertDialogListItem">@color/sk_role_dialog_text</item>
        <item name="android:textColorAlertDialogListItem">@color/sk_role_dialog_text</item>
        <!-- No elevation overlay: in dark themes it tints raised surfaces with the text colour. -->
        <item name="elevationOverlayEnabled">false</item>
        <!-- Every button is a pill: the shape here, colours and the weight of the main action in
             cx.ring.sk.SkViewInflater. -->
        <item name="materialButtonStyle">@style/Widget.Sk.Pill</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Sk.Pill</item>
        <item name="borderlessButtonStyle">@style/Widget.Sk.Pill</item>
        <item name="buttonBarButtonStyle">@style/Widget.Sk.Pill</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Sk.Pill.Main</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Sk.Pill</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Sk.Pill</item>
        <!-- The one place every inflated button, switch, check box and radio button passes through. -->
        <item name="viewInflaterClass">cx.ring.sk.SkViewInflater</item>
    </style>

    <!-- A dialog that deletes: its main button takes the danger role (SkDialogs.destructive). -->
    <style name="ThemeOverlay.Sk.Destructive" parent="">
        <item name="skDestructiveDialog">true</item>
    </style>

    <!-- The pill: fully round, a frame, the ground showing through. Shape only. -->
    <style name="Widget.Sk.Pill" parent="@style/Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minWidth">0dp</item>
        <item name="strokeWidth">1.25dp</item>
        <item name="cornerRadius">100dp</item>
    </style>

    <style name="Widget.Sk.Pill.Main">
        <item name="android:textStyle">bold</item>
        <item name="strokeWidth">3dp</item>
    </style>
</resources>
