+// SK-AUDIODIAG: AudioFrame::calcRMS() logs an ERROR for formats it cannot read, which would spam at
+// frame rate, so only the four it handles are measured.
+float
+AudioLayer::skFrameRms(const AudioFrame& frame)
+{
+    auto* p = frame.pointer();
+    if (!p)
+        return 0.f;
+    switch (p->format) {
+    case AV_SAMPLE_FMT_S16:
+    case AV_SAMPLE_FMT_S16P:
+    case AV_SAMPLE_FMT_FLT:
+    case AV_SAMPLE_FMT_FLTP:
+        return frame.calcRMS();
+    default:
+        return 0.f;
+    }
+}
+
+void
+AudioLayer::skNoteRawCapture(float rms)
+{
+    std::lock_guard lk(skCaptureMutex_);
+    skRawFrames_++;
+    skRawSum_ += rms;
+    skRawPeak_ = std::max(skRawPeak_, (double) rms);
+}
+
+void
+AudioLayer::skNoteProcessedCapture(float rms)
+{
+    bool allZero = false;
+    {
+        std::lock_guard lk(skCaptureMutex_);
+        skOutFrames_++;
+        skOutSum_ += rms;
+        skOutPeak_ = std::max(skOutPeak_, (double) rms);
+
+        auto now = std::chrono::steady_clock::now();
+        if (skLastEmit_.time_since_epoch().count() == 0) {
+            skLastEmit_ = now;
+            return;
+        }
+        if (now - skLastEmit_ < std::chrono::seconds(1))
+            return;
+        skLastEmit_ = now;
+
+        JAMI_WARNING("SK-AUDIODIAG capture raw frm={} rms={:.4f} peak={:.4f} | processed frm={} "
+                     "rms={:.4f} peak={:.4f}",
+                     skRawFrames_,
+                     skRawFrames_ ? skRawSum_ / skRawFrames_ : 0.0,
+                     skRawPeak_,
+                     skOutFrames_,
+                     skOutFrames_ ? skOutSum_ / skOutFrames_ : 0.0,
+                     skOutPeak_);
+
+        // A running capture stream whose raw peak is EXACTLY zero is not a quiet room: a live
+        // microphone always leaks a noise floor. Give it a few seconds in case the stream is still
+        // settling, then report it once.
+        if (skRawFrames_ > 0 && skRawPeak_ == 0.0) {
+            if (++skZeroSeconds_ >= 5 && !skZeroReported_) {
+                skZeroReported_ = true;
+                allZero = true;
+            }
+        } else {
+            skZeroSeconds_ = 0;
+        }
+
+        skRawFrames_ = skOutFrames_ = 0;
+        skRawSum_ = skRawPeak_ = skOutSum_ = skOutPeak_ = 0.0;
+    }
+    if (allZero) {
+        JAMI_ERROR("SK-AUDIODIAG the platform has delivered nothing but digital silence for 5 s — "
+                   "asking the layer to re-open its input");
+        onCaptureAllZero();
+    }
+}
