+// SK-REDIAL: a message that found no channel asks the peer's devices for one — once. If that
+// request goes unanswered (a phone in doze whose wake-up push was not taken for a message), the
+// message used to wait for an unrelated trigger: measured 2026-11-28, one phone's alive ping
+// failed 23 times out of 23 overnight and arrived four times by chance. So, while anything
+// waits, the engine asks again every SK_REDIAL_PERIOD. A redial does not count against
+// MAX_RETRIES: it is the same attempt, repeated, and must not use the message up.
+static constexpr auto SK_REDIAL_PERIOD = std::chrono::minutes(3);
+static constexpr auto SK_REDIAL_MIN_AGE = std::chrono::seconds(60);
+
+void
+MessageEngine::scheduleRedial()
+{
+    // messagesMutex_ is held by the caller.
+    if (redialArmed_ || !account_.redialsUndelivered())
+        return;
+    redialArmed_ = true;
+    redialTimer_.expires_after(SK_REDIAL_PERIOD);
+    redialTimer_.async_wait([this, w = account_.weak_from_this()](const std::error_code& ec) {
+        if (ec)
+            return;
+        if (auto acc = w.lock())
+            redialWaiting();
+    });
+}
+
+void
+MessageEngine::redialWaiting()
+{
+    std::vector<std::string> peers;
+    std::vector<std::string> devices;
+    bool waiting = false;
+    {
+        std::lock_guard lock(messagesMutex_);
+        redialArmed_ = false;
+        const auto now = clock::now();
+        auto collect = [&](const std::map<std::string, std::list<Message>>& map, std::vector<std::string>& out) {
+            for (const auto& [key, list] : map) {
+                bool due = false;
+                for (const auto& m : list) {
+                    if (m.status == MessageStatus::IDLE || m.status == MessageStatus::SENDING)
+                        waiting = true;
+                    if (m.status == MessageStatus::IDLE && now - m.last_op >= SK_REDIAL_MIN_AGE)
+                        due = true;
+                }
+                if (due)
+                    out.emplace_back(key);
+            }
+        };
+        collect(messages_, peers);
+        collect(messagesDevices_, devices);
+        if (waiting)
+            scheduleRedial();
+    }
+    if (!peers.empty() || !devices.empty())
+        JAMI_WARNING("[Account {:s}] SK-REDIAL undelivered messages: asking again for a channel ({:d} peers, {:d} devices)",
+                     account_.getAccountID(),
+                     peers.size(),
+                     devices.size());
+    for (const auto& peer : peers)
+        retrySend(peer, {}, true, true);
+    for (const auto& device : devices)
+        retrySend({}, device, true, true);
+}
