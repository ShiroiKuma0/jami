@@ -80,7 +81,38 @@
 
 // Time related definitions and utility functions
 
+// SK-BOOTCLOCK: the DHT's clock counts the time the machine spent suspended.
+//
+// std::chrono::steady_clock is CLOCK_MONOTONIC on Linux and Android, which stands still while the
+// CPU is suspended. Everything the DHT schedules against the rest of the network is a deadline on
+// OTHER machines' clocks: a value put on a node expires there ten minutes later, a listen thirty
+// seconds later, a token after its rotation. A phone that sleeps for half an hour therefore wakes
+// up believing that ten seconds have passed: the refresh of a permanent put is still "nine minutes
+// away" while the value has long expired on every node that held it, and its nodes still read as
+// freshly heard from. Measured 2026-11-27: a full-DHT phone that was awake 67 % of the time was
+// missing from its own presence key although its DHT reported "connected".
+//
+// CLOCK_BOOTTIME is the same monotonic clock plus the time spent suspended. With it every overdue
+// job runs on the first pass of the scheduler after a resume.
+#if defined(__linux__)
+struct clock
+{
+    using duration = std::chrono::nanoseconds;
+    using rep = duration::rep;
+    using period = duration::period;
+    using time_point = std::chrono::time_point<clock, duration>;
+    static constexpr bool is_steady = true;
+    static time_point now() noexcept
+    {
+        struct timespec ts;
+        if (::clock_gettime(CLOCK_BOOTTIME, &ts) != 0)
+            ::clock_gettime(CLOCK_MONOTONIC, &ts);
+        return time_point(std::chrono::seconds(ts.tv_sec) + std::chrono::nanoseconds(ts.tv_nsec));
+    }
+};
+#else
 using clock = std::chrono::steady_clock;
+#endif
 using system_clock = std::chrono::system_clock;
 using time_point = clock::time_point;
 using duration = clock::duration;
