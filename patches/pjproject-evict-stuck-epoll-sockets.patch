+/* Number of consecutive unconsumed event reports after which a key's fd
+ * is disarmed with EPOLLONESHOT (see ioqueue_note_unhandled()).
+ */
+#ifndef PJ_IOQUEUE_UNHANDLED_EVICT_CNT
+#   define PJ_IOQUEUE_UNHANDLED_EVICT_CNT   5
+#endif
+
+/* Called (with the ioqueue lock held) when epoll reported an
+ * EPOLLERR/EPOLLHUP-carrying event for this key that no pending operation
+ * consumed. Level-triggered epoll re-reports such events on every poll —
+ * and EPOLLERR/EPOLLHUP cannot be masked out at all — so a single dead
+ * socket (e.g. a failed TCP connection, or a candidate socket whose
+ * interface disappeared) turns every poll into a busy loop until the key
+ * is unregistered, which for a long-lived ICE transport may be never.
+ * Callers must gate on the error bits: benign unconsumed EPOLLIN/EPOLLOUT
+ * reports occur sporadically on healthy sockets and must never count.
+ *
+ * After PJ_IOQUEUE_UNHANDLED_EVICT_CNT consecutive unconsumed reports the
+ * key's fd is disarmed. HOW depends on the registration mode, because
+ * EPOLLEXCLUSIVE and EPOLLONESHOT are mutually exclusive in the kernel --
+ * that exact combination is what detect_epoll_support() submits expecting
+ * EINVAL, so an EXCLUSIVE key can never be disarmed with ONESHOT, by MOD
+ * or by DEL+ADD. The two modes therefore need different mechanisms:
+ *
+ *   - EXCLUSIVE key: EPOLL_CTL_DEL. The fd leaves the interest set
+ *     entirely. This is only reached from a call site that has already
+ *     established there is NO pending operation on the key, so nothing is
+ *     waiting on a report that will now not come.
+ *   - otherwise: EPOLL_CTL_MOD adding EPOLLONESHOT, so the kernel delivers
+ *     one final report and then goes quiet.
+ *
+ * In BOTH cases the key's interest bits are cleared from h->ev.events.
+ * That is load-bearing, not bookkeeping tidiness: ioqueue_add_to_set2()
+ * re-registers only `if (events != key->ev.events)`, so leaving the bits
+ * asserted (as an earlier version of this function deliberately did, on
+ * the theory that pjlib's record should stay canonical) means a key whose
+ * interest does not change is never re-armed -- a permanently deaf socket,
+ * which starves its link and produces exactly the reconnect storms this
+ * patch has caused before. Clearing them makes the record honest about
+ * what is actually armed AND guarantees the next posted operation differs,
+ * so update_epoll_event_set() runs and re-registers: MOD for a normal key,
+ * DEL(ENOENT, ignored)+ADD for an EXCLUSIVE one.
+ *
+ * NOTE ON THE COUNTER: h->unhandled_cnt is reset from the dispatch loop,
+ * which runs after pj_lock_release(), so that reset is not serialised
+ * against this function. With one polling thread per ioqueue (dhtnet's
+ * arrangement) there is no race at all; with several, the worst outcome is
+ * a strike lost or applied twice, which only shifts when a dead socket is
+ * disarmed. It is a heuristic, and deliberately not worth a lock.
+ */
+static void ioqueue_note_unhandled(pj_ioqueue_t *ioqueue,
+                                   pj_ioqueue_key_t *h)
+{
+    struct epoll_event ev;
+    pj_uint32_t disarmed;
+    int rc;
+
+    if (IS_CLOSING(h))
+        return; /* about to be unregistered anyway */
+
+    if (ioqueue->cfg.epoll_flags & PJ_IOQUEUE_EPOLL_ONESHOT)
+        return; /* kernel already disarms after every delivery */
+
+    if (++h->unhandled_cnt < PJ_IOQUEUE_UNHANDLED_EVICT_CNT)
+        return;
+
+    /* What the registration keeps once our interest is withdrawn. */
+    disarmed = h->ev.events & ~(pj_uint32_t)(EPOLLIN | EPOLLOUT);
+
+    pj_bzero(&ev, sizeof(ev));
+    ev.epoll_data = (epoll_data_type)h;
+
+    if (h->ev.events & EPOLLEXCLUSIVE) {
+        ev.events = h->ev.events;
+        rc = os_epoll_ctl(ioqueue->epfd, EPOLL_CTL_DEL, h->fd, &ev);
+    } else {
+        ev.events = h->ev.events | EPOLLONESHOT;
+        rc = os_epoll_ctl(ioqueue->epfd, EPOLL_CTL_MOD, h->fd, &ev);
+    }
+
+    if (rc != 0) {
+        PJ_PERROR(4,(THIS_FILE, pj_get_os_error(),
+                     "evict: epoll_ctl disarm error fd=%d events=0x%x",
+                     (int)h->fd, h->ev.events));
+    } else {
+        /* This path had never once executed in production before 2026-08-05
+         * -- the old EPOLLEXCLUSIVE early-return disabled it on every key of
+         * every kernel that supports EXCLUSIVE. Say so out loud the first
+         * time it fires, rather than trusting an unexercised branch: without
+         * this the only evidence would be a TRACE_WARN that is compiled out.
+         */
+        SK_EVICT("disarmed fd=%d after %u unconsumed error events (%s)",
+                 (int)h->fd, h->unhandled_cnt,
+                 (h->ev.events & EPOLLEXCLUSIVE) ? "DEL/exclusive"
+                                                 : "MOD/oneshot");
+        h->ev.events = disarmed;
+    }
+    h->unhandled_cnt = 0;
+}
