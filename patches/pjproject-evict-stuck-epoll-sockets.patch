+/* Number of consecutive unconsumed event reports after which a key's fd
+ * is disarmed with EPOLLONESHOT (see ioqueue_note_unhandled()).
+ */
+#ifndef PJ_IOQUEUE_UNHANDLED_EVICT_CNT
+#   define PJ_IOQUEUE_UNHANDLED_EVICT_CNT   5
+#endif
+
+/* Called (with the ioqueue lock held) when epoll reported an
+ * EPOLLERR/EPOLLHUP-carrying event for this key that no pending operation
+ * consumed. Level-triggered epoll re-reports such events on every poll —
+ * and EPOLLERR/EPOLLHUP cannot be masked out at all — so a single dead
+ * socket (e.g. a failed TCP connection, or a candidate socket whose
+ * interface disappeared) turns every poll into a busy loop until the key
+ * is unregistered, which for a long-lived ICE transport may be never.
+ * Callers must gate on the error bits: benign unconsumed EPOLLIN/EPOLLOUT
+ * reports occur sporadically on healthy sockets and must never count.
+ *
+ * After PJ_IOQUEUE_UNHANDLED_EVICT_CNT consecutive unconsumed reports the
+ * fd is disarmed with EPOLLONESHOT: the kernel delivers one final report
+ * and then goes quiet. Any later update_epoll_event_set() (epoll_ctl MOD
+ * without EPOLLONESHOT, e.g. from ioqueue_add_to_set() when an operation
+ * is posted) re-arms level-triggered reporting, so a key that becomes
+ * active again recovers automatically. key->ev.events is deliberately
+ * left untouched so pjlib's own bookkeeping stays canonical.
+ */
+static void ioqueue_note_unhandled(pj_ioqueue_t *ioqueue,
+                                   pj_ioqueue_key_t *h)
+{
+    struct epoll_event ev;
+
+    if (IS_CLOSING(h))
+        return; /* about to be unregistered anyway */
+
+    if (ioqueue->cfg.epoll_flags & PJ_IOQUEUE_EPOLL_ONESHOT)
+        return; /* kernel already disarms after every delivery */
+
+    if (h->ev.events & EPOLLEXCLUSIVE)
+        return; /* EPOLL_CTL_MOD is invalid on EXCLUSIVE registrations */
+
+    if (++h->unhandled_cnt < PJ_IOQUEUE_UNHANDLED_EVICT_CNT)
+        return;
+
+    pj_bzero(&ev, sizeof(ev));
+    ev.epoll_data = (epoll_data_type)h;
+    ev.events = h->ev.events | EPOLLONESHOT;
+    if (os_epoll_ctl(ioqueue->epfd, EPOLL_CTL_MOD, h->fd, &ev) != 0) {
+        PJ_PERROR(4,(THIS_FILE, pj_get_os_error(),
+                     "evict: epoll_ctl(MOD, ONESHOT) error fd=%d",
+                     (int)h->fd));
+    } else {
+        TRACE_WARN((THIS_FILE, "     disarmed idle-erroring fd=%d after %u "
+                    "unconsumed events", (int)h->fd, h->unhandled_cnt));
+    }
+    h->unhandled_cnt = 0;
+}
+
+
