 static constexpr int MAX_DESTRUCTION_TIMEOUT {3000};
 static constexpr int HANDLE_EVENT_DURATION {500};
 static constexpr std::chrono::seconds PORT_MAPPING_TIMEOUT {4};
+
+/* Circuit breaker for the UPnP port-mapping path.
+ *
+ * requestUpnpMappings() blocks every ICE transport setup for up to
+ * PORT_MAPPING_TIMEOUT waiting for a mapping. When the router's UPnP
+ * service is down (dead IGD, disabled service, exhausted table), every
+ * request fails — and every connection attempt keeps paying the wait,
+ * in exactly the time-critical window where ICE must complete.
+ *
+ * The breaker counts consecutive mapping failures across all transports;
+ * after UPNP_BREAKER_THRESHOLD of them it opens for
+ * UPNP_BREAKER_COOLDOWN, during which requestUpnpMappings() returns
+ * immediately (ICE proceeds with host/STUN/TURN candidates, i.e. the
+ * exact behavior of UPnP-disabled). After the cooldown one attempt is
+ * let through (half-open probe): success closes the breaker, failure
+ * re-opens it. Any successful mapping resets the failure counter, so a
+ * healthy router is never affected.
+ */
+static constexpr unsigned UPNP_BREAKER_THRESHOLD {6};
+static constexpr std::chrono::minutes UPNP_BREAKER_COOLDOWN {5};
+static std::atomic<unsigned> upnpBreakerFails {0};
+static std::atomic<int64_t> upnpBreakerOpenUntilMs {0};
+
+static int64_t
+upnpBreakerNowMs()
+{
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+}
