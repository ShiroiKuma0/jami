diff --git a/src/media/audio/sk_audio_diag.h b/src/media/audio/sk_audio_diag.h
new file mode 100644
index 000000000..5e00f8de1
--- /dev/null
+++ b/src/media/audio/sk_audio_diag.h
@@ -0,0 +1,221 @@
+/*
+ *  SK-AUDIODIAG — per-call audio-path instrumentation (2026-07-31)
+ *
+ *  Diagnostic only: nothing here changes media behaviour. It exists to answer, from OUR phone
+ *  alone, where a peer's audio dies when the call connects and only one direction carries sound.
+ *
+ *  The question this settles is a three-way fork that is otherwise indistinguishable on the
+ *  receiving end, because every one of the three looks identical to the user (a connected call
+ *  with silence) and identical to the daemon (no error anywhere):
+ *
+ *    1. no inbound RTP at all              -> the peer's sender never ran, or transport is broken
+ *                                             (one-way ICE pair, stale relay permission)
+ *    2. inbound RTP whose samples are zero -> the peer's CAPTURE CONTENT is silence: muted, the
+ *                                             device's echo canceller nulling the uplink, capture
+ *                                             routed to a dead device, or the HAL feeding the
+ *                                             daemon zero-filled buffers
+ *    3. inbound RTP with real samples      -> the fault is on our side, at playback
+ *
+ *  Counters are grouped by where they sit in the path, so a single log line separates transport
+ *  from content:
+ *
+ *    rx*   SocketPair::readCallback  — raw RTP as it comes off the socket, BEFORE decrypt/decode.
+ *          Non-zero here with zero dec* means the packets arrive and die in SRTP or the decoder.
+ *    dec*  the MediaDecoder callback in AudioReceiveThread — the peer's audio AFTER decode, i.e.
+ *          exactly the samples we are about to play. RMS 0 here is case 2.
+ *    tx*   AudioSender::update — our own captured frames. Present so the log proves the leg that
+ *          works is healthy and the instrumentation itself is sound; a diagnostic that only ever
+ *          reports zeros cannot tell a dead path from a dead probe.
+ *
+ *  Ownership: one object per AudioRtpSession, handed as a shared_ptr to the sender, the receive
+ *  thread and the socket pair. That indirection is deliberate — sender_/receiveThread_/socketPair_
+ *  are reset on every re-INVITE while the RTCP checker thread is live, so a diagnostic reading
+ *  through those pointers would race. Each holder gets its own reference and the counters outlive
+ *  any of them. Setters are called immediately after construction, before the object is handed to
+ *  any thread, so no lock is needed to publish the pointer.
+ *
+ *  Emission is driven from AudioSender::update (a 20 ms cadence, so the line lands even while
+ *  nothing at all is arriving) and from the decoder callback (so it still lands if we are
+ *  receive-only), rate-limited to one line per second by whichever thread wins the CAS.
+ */
+
+#pragma once
+
+#include "logger.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <string_view>
+
+namespace jami {
+
+class SkAudioDiag
+{
+public:
+    explicit SkAudioDiag(std::string label)
+        : label_(std::move(label))
+    {}
+
+    // Raw RTP off the socket, before decrypt. Called on the receive thread.
+    void noteRxPacket(int bytes)
+    {
+        rxPackets_.fetch_add(1, std::memory_order_relaxed);
+        rxBytes_.fetch_add(bytes > 0 ? static_cast<uint64_t>(bytes) : 0, std::memory_order_relaxed);
+        lastRxMs_.store(nowMs(), std::memory_order_relaxed);
+    }
+
+    void noteRxDecryptError() { rxDecryptErr_.fetch_add(1, std::memory_order_relaxed); }
+
+    // The peer's audio after decode — the samples we are about to play.
+    void noteDecoded(float rms)
+    {
+        accumulate(decFrames_, decRmsSum_, decRmsPeak_, rms);
+        maybeEmit();
+    }
+
+    // Our own captured audio, after the audio processor and after any mute zero-fill.
+    void noteSent(float rms, bool hasVoice)
+    {
+        accumulate(txFrames_, txRmsSum_, txRmsPeak_, rms);
+        if (hasVoice)
+            txVoice_.fetch_add(1, std::memory_order_relaxed);
+        maybeEmit();
+    }
+
+    // One-shot line describing what was negotiated, logged once the session has started. Race-free:
+    // called from AudioRtpSession::start() with the session mutex held.
+    void logSetup(std::string_view codec,
+                  bool sendEnabled,
+                  bool sendHold,
+                  bool recvEnabled,
+                  bool recvHold,
+                  bool muteTx,
+                  bool srtp,
+                  std::string_view remote)
+    {
+        JAMI_WARNING("SK-AUDIODIAG [{}] setup codec={} send={}{} recv={}{} muteTx={} srtp={} remote={}",
+                     label_,
+                     codec.empty() ? std::string_view("none") : codec,
+                     sendEnabled ? "on" : "OFF",
+                     sendHold ? "+hold" : "",
+                     recvEnabled ? "on" : "OFF",
+                     recvHold ? "+hold" : "",
+                     muteTx ? "YES" : "no",
+                     srtp ? "yes" : "no",
+                     remote);
+    }
+
+private:
+    static int64_t nowMs()
+    {
+        return std::chrono::duration_cast<std::chrono::milliseconds>(
+                   std::chrono::steady_clock::now().time_since_epoch())
+            .count();
+    }
+
+    // RMS is normalized 0..1 (AudioFrame::calcRMS); kept as fixed point x10000 so the accumulators
+    // can stay integral atomics.
+    static void accumulate(std::atomic<uint64_t>& frames,
+                           std::atomic<uint64_t>& sum,
+                           std::atomic<uint64_t>& peak,
+                           float rms)
+    {
+        auto v = static_cast<uint64_t>(rms * 10000.f + 0.5f);
+        frames.fetch_add(1, std::memory_order_relaxed);
+        sum.fetch_add(v, std::memory_order_relaxed);
+        auto seen = peak.load(std::memory_order_relaxed);
+        while (v > seen && not peak.compare_exchange_weak(seen, v, std::memory_order_relaxed)) {
+        }
+    }
+
+    void maybeEmit()
+    {
+        auto now = nowMs();
+        auto last = lastEmitMs_.load(std::memory_order_relaxed);
+        if (last != 0 and now - last < 1000)
+            return;
+        // Only one thread emits per interval; the loser simply returns.
+        if (not lastEmitMs_.compare_exchange_strong(last, now, std::memory_order_relaxed))
+            return;
+        if (last == 0)
+            return; // first call only arms the clock
+
+        std::lock_guard lk(emitMutex_);
+        auto rxP = rxPackets_.load(std::memory_order_relaxed);
+        auto rxB = rxBytes_.load(std::memory_order_relaxed);
+        auto rxE = rxDecryptErr_.load(std::memory_order_relaxed);
+        auto decF = decFrames_.load(std::memory_order_relaxed);
+        auto decS = decRmsSum_.load(std::memory_order_relaxed);
+        auto decPk = decRmsPeak_.exchange(0, std::memory_order_relaxed);
+        auto txF = txFrames_.load(std::memory_order_relaxed);
+        auto txS = txRmsSum_.load(std::memory_order_relaxed);
+        auto txPk = txRmsPeak_.exchange(0, std::memory_order_relaxed);
+        auto txV = txVoice_.load(std::memory_order_relaxed);
+        auto lastRx = lastRxMs_.load(std::memory_order_relaxed);
+
+        auto dRxP = rxP - prevRxPackets_;
+        auto dRxB = rxB - prevRxBytes_;
+        auto dDecF = decF - prevDecFrames_;
+        auto dDecS = decS - prevDecRmsSum_;
+        auto dTxF = txF - prevTxFrames_;
+        auto dTxS = txS - prevTxRmsSum_;
+        auto dTxV = txV - prevTxVoice_;
+        prevRxPackets_ = rxP;
+        prevRxBytes_ = rxB;
+        prevDecFrames_ = decF;
+        prevDecRmsSum_ = decS;
+        prevTxFrames_ = txF;
+        prevTxRmsSum_ = txS;
+        prevTxVoice_ = txV;
+
+        auto mean = [](uint64_t sum, uint64_t frames) {
+            return frames ? static_cast<double>(sum) / static_cast<double>(frames) / 10000.0 : 0.0;
+        };
+
+        JAMI_WARNING("SK-AUDIODIAG [{}] rx pkt+{} B+{} srtpErr={} idle={}ms | dec frm+{} rms={:.4f} "
+                     "peak={:.4f} tot={} | tx frm+{} rms={:.4f} peak={:.4f} voice={}/{}",
+                     label_,
+                     dRxP,
+                     dRxB,
+                     rxE,
+                     lastRx ? now - lastRx : -1,
+                     dDecF,
+                     mean(dDecS, dDecF),
+                     decPk / 10000.0,
+                     decF,
+                     dTxF,
+                     mean(dTxS, dTxF),
+                     txPk / 10000.0,
+                     dTxV,
+                     dTxF);
+    }
+
+    const std::string label_;
+
+    std::atomic<uint64_t> rxPackets_ {0};
+    std::atomic<uint64_t> rxBytes_ {0};
+    std::atomic<uint64_t> rxDecryptErr_ {0};
+    std::atomic<uint64_t> decFrames_ {0};
+    std::atomic<uint64_t> decRmsSum_ {0};
+    std::atomic<uint64_t> decRmsPeak_ {0};
+    std::atomic<uint64_t> txFrames_ {0};
+    std::atomic<uint64_t> txRmsSum_ {0};
+    std::atomic<uint64_t> txRmsPeak_ {0};
+    std::atomic<uint64_t> txVoice_ {0};
+    std::atomic<int64_t> lastRxMs_ {0};
+    std::atomic<int64_t> lastEmitMs_ {0};
+
+    std::mutex emitMutex_;
+    uint64_t prevRxPackets_ {0};
+    uint64_t prevRxBytes_ {0};
+    uint64_t prevDecFrames_ {0};
+    uint64_t prevDecRmsSum_ {0};
+    uint64_t prevTxFrames_ {0};
+    uint64_t prevTxRmsSum_ {0};
+    uint64_t prevTxVoice_ {0};
+};
+
+} // namespace jami
