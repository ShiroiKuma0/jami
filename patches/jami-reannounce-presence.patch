+/* SK-REANNOUNCE: send the device announcement to the network again, now.
+ *
+ * startSync() puts the announcement once, as a permanent put, and leaves the refreshing to opendht,
+ * which re-sends it ten seconds before the ten minutes after which the storing nodes drop it. A
+ * phone that sleeps misses that moment, and nothing else ever puts the announcement again: the
+ * account stays "registered" while its presence key is empty and every peer shows it offline
+ * (measured 2026-11-27 on a full-DHT phone). The application calls this from a timer that wakes the
+ * phone, so that the announcement is renewed inside every expiry window.
+ *
+ * A second put() of the same value does nothing while opendht believes it is still announced, so
+ * the put is cancelled first; the new one then starts from every node afresh. Both run in order on
+ * the DHT's own thread. */
+void
+AccountManager::reannouncePresence()
+{
+    if (!info_ || !info_->announce || !dht_ || !dht_->isRunning())
+        return;
+    // The id is set by startSync(); without it nothing was ever announced.
+    if (info_->announce->id == dht::Value::INVALID_ID)
+        return;
+    auto h = dht::InfoHash(info_->accountId);
+    dht_->cancelPut(h, info_->announce->id);
+    dht_->put(h, info_->announce, dht::DoneCallback {}, {}, true);
+}
