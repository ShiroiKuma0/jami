+/**
+ * SK-CAPTUREZERO: the platform has been handing us digital silence. Switch the input away from the
+ * low-latency voice-communication path and restart it, once per process.
+ *
+ * This runs on the capture callback's thread, so the work is handed to the existing restart loop
+ * (the same one that recovers a disconnected stream) rather than stopping the stream from inside its
+ * own callback. A device whose microphone works normally never reaches here — the trigger requires a
+ * peak of exactly zero, which a live microphone does not produce.
+ */
+void
+AAudioLayer::onCaptureAllZero()
+{
+    if (captureFallback_.exchange(true))
+        return;
+    JAMI_ERROR("Capture delivered only silence — restarting the input on the fallback path");
+    // Remember it, so this is paid once per device and not once per process start.
+    try {
+        std::ofstream marker(captureFallbackMarker());
+        marker << "the low-latency voice-communication capture path delivers only silence on this device\n";
+    } catch (const std::exception& e) {
+        JAMI_ERROR("Unable to persist the capture fallback: {}", e.what());
+    }
+    // Off this thread, and without taking mutex_ here: this runs on the capture data callback, and the
+    // restart loop holds mutex_ while calling AAudioStream_requestStop(), which itself waits for the
+    // data callback to return. Blocking on mutex_ from inside the callback would deadlock the two
+    // against each other.
+    dht::ThreadPool::io().run([this] {
+        std::lock_guard lk(mutex_);
+        streamsToRestart_.insert(AudioDeviceType::CAPTURE);
+        loopCv_.notify_one();
+    });
+}
