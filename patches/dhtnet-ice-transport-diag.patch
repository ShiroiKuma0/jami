+// SK-ICEDIAG (2026-07-30): IceTransport lifecycle census.
+//
+// Each IceTransport spawns one std::thread running handleEvents(), and profiling an idle phone put
+// 96% of the app's CPU inclusive in that loop — ~1% of a core per thread, across 9 threads whose
+// ages showed NONE had ever been destroyed. That is either a leak (transports outliving their ICE
+// session) or the honest price of nine live connections, and the two call for opposite fixes. This
+// only logs; it changes no behaviour.
+//
+// Direct __android_log_print, not logger_: the daemon leaves opendht's logger null unless
+// dhtLogLevel > 0, so logger_->debug() is silent in a release build (same reason SK-PROXYDIAG
+// exists). ERROR level so LogStormMonitor's own-pid *:E tail picks it up.
+#ifdef __ANDROID__
+#include <android/log.h>
+#define SK_ICE(...) __android_log_print(ANDROID_LOG_ERROR, "SK-ICEDIAG", __VA_ARGS__)
+#else
+#define SK_ICE(...) do {} while (0)
+#endif
+static std::atomic<unsigned> skIceCreated {0};
+static std::atomic<unsigned> skIceDestroyed {0};
+static std::atomic<int> skIceAlive {0};
+
