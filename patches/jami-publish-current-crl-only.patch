diff --git a/src/jamidht/account_manager.h b/src/jamidht/account_manager.h
index 5134fec28..679f7d105 100644
--- a/src/jamidht/account_manager.h
+++ b/src/jamidht/account_manager.h
@@ -58,6 +58,24 @@ struct AccountInfo
     std::string photo;
 };
 
+/* SK-CRL-CURRENT (shiroikuma fork, 2026-07-26): deterministic dht::Value id for a revocation list.
+ *
+ * A dht::Value put with an unset id gets a RANDOM one assigned by opendht
+ * ("if (val->id == Value::INVALID_ID) val->id = uniform_int_distribution{1}(rd)", dht.cpp), so
+ * re-publishing the same CRL ADDS a copy instead of replacing the stored value. Deriving the id
+ * from the CRL's own bytes makes the put idempotent across registrations, restarts and devices.
+ * Returns uint64_t rather than dht::Value::Id so this header needs no <opendht/value.h>. */
+inline uint64_t
+crlValueId(const dht::crypto::RevocationList& crl)
+{
+    const auto packed = crl.getPacked();
+    const auto h = dht::InfoHash::get(packed.data(), packed.size());
+    uint64_t id = 0;
+    for (unsigned i = 0; i < sizeof(id); ++i)
+        id = (id << 8) | h[i];
+    return id ? id : 1; // 0 is dht::Value::INVALID_ID — would draw a random id again
+}
+
 template<typename To, typename From>
 std::unique_ptr<To>
 dynamic_unique_cast(std::unique_ptr<From>&& p)
