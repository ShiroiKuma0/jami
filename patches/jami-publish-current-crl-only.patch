+/* SK-CRL-CURRENT (shiroikuma fork, 2026-07-27): keep exactly ONE permanent CRL put alive per
+ * account key, for the whole daemon run.
+ *
+ * The value id is derived from the CRL's own bytes, so a newer CRL necessarily lands under a
+ * different id — it cannot replace its predecessor in place, and must not try to. A fixed "slot"
+ * id looks tempting but is broken in current OpenDHT for this value:
+ *
+ *   - The CRL goes out through SecureDht::put(), which does NOT sign (securedht.h), so the stored
+ *     value is an unsigned ValueType::USER_DATA. SecureDht::secureType()'s edit wrapper defers to
+ *     the base policy for unsigned values, and USER_DATA's is DEFAULT_EDIT_POLICY — `return false`.
+ *     A node that already holds the old CRL under that id answers a put of the new one with
+ *     "Rejecting edition ... because of storage policy" (dht.cpp).
+ *   - Worse, it would never even get that far: when the announce step finds the target already
+ *     holds our value id and `seq_no < value->seq` is false (unsigned values keep seq == 0), it
+ *     renews the put with a bare id-only 'refresh' (dht.cpp) — which extends the lifetime of the
+ *     SUPERSEDED CRL on precisely the closest nodes that serve it.
+ *   - And signing to unlock the seq-increasing edit path would not survive multiple devices: the
+ *     edit policy requires an unchanged owner, and SecureDht signs with the *device* key.
+ *
+ * So: let the new CRL take its own id, and cancel the one it supersedes. cancelPut() drops the
+ * local permanent put and removes the value from our own store, so the superseded CRL stops being
+ * re-announced and expires from the network within one value expiration (10 min). Without this,
+ * revoking a device mid-run leaves startSync's put of the previous CRL refreshing alongside the new
+ * one until the next restart.
+ *
+ * Content-derived ids stay the right choice for the rest: two devices publishing the same current
+ * CRL derive the same id for identical bytes, so they refresh one value instead of adding a copy.
+ */
+/* SK-CRL-CURRENT: compare two X.509 CRL numbers as big-endian unsigned integers.
+ *
+ * The number is the tiebreak that makes CRL freshness a TOTAL order: getUpdateTime() comes from the
+ * thisUpdate field, which has one-second granularity, so two lists generated in the same second
+ * would otherwise compare equal and a stale publisher could roll back a revocation. Within one
+ * account the number is strictly increasing — opendht's RevocationList::sign() seeds it randomly on
+ * the first signature and increments it by one on every later one (crypto.cpp) — and we only ever
+ * compare lists belonging to the same account. Leading zeroes are skipped so the comparison does not
+ * depend on the encoded width. */
+static bool
+crlNumberLess(const dht::Blob& a, const dht::Blob& b)
+{
+    const auto significant = [](const dht::Blob& v) {
+        auto it = v.begin();
+        while (it != v.end() and *it == 0)
+            ++it;
+        return it;
+    };
+    const auto ab = significant(a), bb = significant(b);
+    const auto aLen = std::distance(ab, a.end()), bLen = std::distance(bb, b.end());
+    if (aLen != bLen)
+        return aLen < bLen;
+    return std::lexicographical_compare(ab, a.end(), bb, b.end());
+}
+
+void
+AccountManager::publishCurrentCrl(const dht::InfoHash& h, const std::shared_ptr<dht::crypto::RevocationList>& crl)
+{
+    if (not crl or not dht_)
+        return;
+    const auto updateTime = crl->getUpdateTime();
+    const auto number = crl->getNumber();
+    const dht::Value::Id id = crlValueId(*crl);
+
+    /* The whole decision is serialized, not just the bookkeeping write: startSync() and
+     * revokeDevice() publish from different threads, and an unserialized cancel/put pair lets a
+     * slower call from an in-flight registration cancel the CRL a concurrent revocation has just
+     * published, leaving the account announcing the pre-revocation list. Ordering on top of the lock
+     * is what makes the outcome independent of which thread wins the race — the newest list ends up
+     * published whichever order the calls arrive in. Holding the lock across the DHT calls is cheap:
+     * put()/cancelPut() only queue an operation on the DhtRunner. */
+    std::lock_guard<std::mutex> lock(publishedCrlMutex_);
+    if (publishedCrlId_ and id != publishedCrlId_) {
+        // A different list from the one we are publishing: take it only if it is strictly newer.
+        // Re-publishing the SAME list (equal id) always proceeds, so a re-registration can restore
+        // the permanent put after the DhtRunner has been restarted.
+        const bool newer = updateTime > publishedCrlTime_
+                           or (updateTime == publishedCrlTime_ and crlNumberLess(publishedCrlNumber_, number));
+        if (not newer)
+            return;
+        dht_->cancelPut(h, publishedCrlId_);
+    }
+    publishedCrlId_ = id;
+    publishedCrlTime_ = updateTime;
+    publishedCrlNumber_ = number;
+
+    auto crlVal = std::make_shared<dht::Value>(*crl);
+    crlVal->priority = 1; // CRLs are not urgent — use normal priority
+    crlVal->id = id;
+    dht_->put(h, crlVal, dht::DoneCallback {}, {}, true);
+}
