+/* SK-CRL-CURRENT (shiroikuma fork, 2026-07-26): deterministic dht::Value id for a revocation list.
+ *
+ * A dht::Value put with an unset id gets a RANDOM one assigned by opendht
+ * ("if (val->id == Value::INVALID_ID) val->id = uniform_int_distribution{1}(rd)", dht.cpp), so
+ * re-publishing the same CRL ADDS a copy instead of replacing the stored value. Deriving the id
+ * from the CRL's own bytes makes the put idempotent across registrations, restarts and devices.
+ * Returns uint64_t rather than dht::Value::Id so this header needs no <opendht/value.h>. */
+inline uint64_t
+crlValueId(const dht::crypto::RevocationList& crl)
+{
+    const auto packed = crl.getPacked();
+    const auto h = dht::InfoHash::get(packed.data(), packed.size());
+    uint64_t id = 0;
+    for (unsigned i = 0; i < sizeof(id); ++i)
+        id = (id << 8) | h[i];
+    return id ? id : 1; // 0 is dht::Value::INVALID_ID — would draw a random id again
+}
+
+/* SK-ANNOUNCE-ID (shiroikuma fork, 2026-07-26): the same treatment for an already-built dht::Value.
+ *
+ * Used for the device announcement, which had the identical defect: a fresh random id per daemon run
+ * left one orphaned copy of the announcement on the account key per run (12 observed on one key).
+ *
+ * Deriving the id from getToSign() — the exact blob checkSignature() verifies (seq, owner, type,
+ * data, user_type) — is safe for SIGNED values: the id is NOT part of that blob, so changing it
+ * cannot invalidate a signature. It also guarantees two devices derive different ids, since their
+ * announcements differ in both owner and data. */
+inline uint64_t
+dhtValueId(const dht::Value& v)
+{
+    const auto blob = v.getToSign();
+    const auto h = dht::InfoHash::get(blob.data(), blob.size());
+    uint64_t id = 0;
+    for (unsigned i = 0; i < sizeof(id); ++i)
+        id = (id << 8) | h[i];
+    return id ? id : 1; // 0 is dht::Value::INVALID_ID — would draw a random id again
+}
