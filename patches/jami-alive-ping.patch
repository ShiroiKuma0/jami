 // SK-READRETRY: messages the client never showed as a message of its own (conversation
 // announcements, read receipts) change no message status on the client side.
+// SK-ALIVE: an "alive" ping between two accounts (the Android bridge's bridge_ping). It is an
+// account message of a MIME type of our own: it dials the peer like any message, and is never
+// committed to a conversation.
+static constexpr const char SK_ALIVE_MIME[] {"application/x-sk-alive"};
+
 static bool
 isSilent(const std::map<std::string, std::string>& payloads)
 {
     return payloads.find("application/im-gitmessage-id") != payloads.end()
-           || payloads.find("message/imdn+xml") != payloads.end();
+           || payloads.find("message/imdn+xml") != payloads.end()
+           || payloads.find(SK_ALIVE_MIME) != payloads.end();
 }
 
