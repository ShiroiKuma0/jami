+// SK-SWARMBACKOFF: upstream has NO backoff anywhere in the swarm layer — grep the whole directory
+// for backoff/retry constants and nothing comes back. A speculative dial that fails is retried on
+// the very next event with no memory of the attempt. Upstream's actual damper is a classification:
+// a peer that advertises is_mobile is filed into Bucket::mobile_nodes on disconnect, and
+// maintainBuckets only draws from known_nodes. But Bucket::addKnownNode never consults
+// mobile_nodes, and Conversation::addKnownDevices() -> setKnownNodes() feeds the DRT a candidate on
+// EVERY presence announce (it is the sole candidate-injection path), so the phone is re-promoted and
+// redialled every time it is mentioned. Repairing addKnownNode instead would starve the routing
+// table of candidates entirely for an all-mobile conversation, so the damper belongs here.
+//
+// Gate the SPECULATIVE path only. connectNode() -> tryConnect(id, /*noNewSocket=*/true) is
+// event-driven and reuse-only; it never passes through here and stays immediate.
+//
+// 60 s base, doubling, 30 min cap. The base has to clear 30 s: a dead ICE offer is reaped at
+// exactly 30 s (measured 2026-07-30, 373 samples, min 30 / median 30 / max 60), so a 10 s or even
+// 30 s base would fire the retry while the previous offer is still outstanding and stack two live
+// offers — each paying its own candidate gathering and DHT put — on the same peer.
+bool
+SwarmManager::redialAllowed(const NodeId& nodeId) const
+{
+    auto it = redialBackoff_.find(nodeId);
+    if (it == redialBackoff_.end())
+        return true;
+    return std::chrono::steady_clock::now() >= it->second.nextAllowed;
+}
+
+void
+SwarmManager::noteRedialFailure(const NodeId& nodeId)
+{
+    auto now = std::chrono::steady_clock::now();
+    // Keep the map bounded: device ids churn over a long-running daemon, and an entry whose window
+    // has already elapsed carries no information.
+    if (redialBackoff_.size() > 256) {
+        for (auto it = redialBackoff_.begin(); it != redialBackoff_.end();) {
+            if (it->second.nextAllowed <= now)
+                it = redialBackoff_.erase(it);
+            else
+                ++it;
+        }
+    }
+    auto& st = redialBackoff_[nodeId];
+    unsigned shift = st.failures > 5 ? 5 : st.failures;
+    auto delay = SK_REDIAL_BASE * (1LL << shift);
+    if (delay > SK_REDIAL_CAP)
+        delay = SK_REDIAL_CAP;
+    if (st.failures < 32)
+        st.failures++;
+    st.nextAllowed = now + delay;
+}
+
+void
+SwarmManager::noteRedialSuccess(const NodeId& nodeId)
+{
+    std::lock_guard lock(mutex);
+    redialBackoff_.erase(nodeId);
+}
