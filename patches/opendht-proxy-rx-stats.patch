 namespace dht {
 
+// SK-PROXYRX: what a proxy client has received, for the application's connection watchdog. This
+// is NOT a diagnostic and is not behind any diagnostics switch: the watchdog decides on it.
+struct OPENDHT_PUBLIC SkProxyRxStats
+{
+    bool found {false};        // a proxy client with that push client id exists
+    int64_t lastRxAgeMs {-1};  // ms since the last inbound (listen body or push); -1 = none yet
+    uint64_t listeners {0};    // active listeners
+    uint64_t pushRx {0};       // push notifications received
+    uint64_t rxLines {0};      // values received on listen response bodies
+    std::string proxy;         // the proxy this client talks to
+};
+
+// SK-PROXYRX: the figures of the live proxy client created with this push client id (the daemon
+// passes its account id). Thread-safe; found=false when there is none.
