+SkProxyRxStats
+DhtProxyClient::skRxStats()
+{
+    SkProxyRxStats s;
+    s.found = true;
+    s.proxy = proxyUrl_;
+    {
+        std::lock_guard lock(searchLock_);
+        for (auto& search : searches_)
+            s.listeners += search.second.listeners.size();
+    }
+    s.pushRx = diagPushRx_.load();
+    s.rxLines = diagRxLines_.load();
+    auto last = diagLastRxMs_.load();
+    if (last) {
+        auto nowMs = std::chrono::duration_cast<std::chrono::milliseconds>(
+                         std::chrono::steady_clock::now().time_since_epoch())
+                         .count();
+        s.lastRxAgeMs = nowMs > last ? nowMs - last : 0;
+    }
+    return s;
+}
