 namespace dht {
 
+// SK-PROXYRX: live proxy clients by push client id, so that the application can ask what one of
+// them has received without reaching through DhtRunner (which swaps its dht on its own thread).
+static std::mutex&
+skRxRegistryLock()
+{
+    static std::mutex m;
+    return m;
+}
+static std::map<std::string, DhtProxyClient*>&
+skRxRegistry()
+{
+    static std::map<std::string, DhtProxyClient*> r;
+    return r;
+}
+
+SkProxyRxStats
+skProxyRxStats(const std::string& pushClientId)
+{
+    std::lock_guard l(skRxRegistryLock());
+    auto& r = skRxRegistry();
+    auto it = r.find(pushClientId);
+    if (it == r.end())
+        return {};
+    return it->second->skRxStats();
+}
