+void
+ConnectionManager::Impl::handleIncomingRequest(PeerConnectionRequest&& req)
+{
+    if (!req.owner)
+        return;
+    if (isMessageTreated(req.id))
+        return;   // already treated — just ignore
+    auto from = req.owner->getLongId();
+    if (req.isAnswer) {
+        if (config_->logger)
+            config_->logger->debug("[device {}] Received request answer", from);
+        onPeerResponse(std::move(req));
+        return;
+    }
+    if (config_->logger)
+        config_->logger->debug("[device {}] Received request", from);
+    // Async certificate checking
+    findCertificate(from,
+                    [w = weak_from_this(), req = std::move(req)](
+                        const std::shared_ptr<dht::crypto::Certificate>& cert) mutable {
+                        auto shared = w.lock();
+                        if (!shared)
+                            return;
+                        dht::InfoHash peer_h;
+                        if (foundPeerDevice(cert, peer_h, shared->config_->logger)) {
+#if TARGET_OS_IOS
+                            if (shared->iOSConnectedCb_(req.connType, peer_h))
+                                return;
+#endif
+                            shared->onDhtPeerRequest(req, false, cert);
+                        } else {
+                            if (shared->config_->logger)
+                                shared->config_->logger->warn(
+                                    "[device {}] Received request from untrusted peer",
+                                    req.owner->getLongId());
+                        }
+                    });
 }
 
