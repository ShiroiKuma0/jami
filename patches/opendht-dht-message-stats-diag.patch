+// SK-DHTSTATS: opendht already counts every DHT message by kind and direction
+// (NetworkEngine in_stats/out_stats -> getNodeMessageStats), and counts routing-table entries
+// learned PASSIVELY from inbound requests (NodeStats::incoming_nodes). Jami exposes neither, so
+// "how much of our DHT traffic is us serving other people?" has only ever been estimated. Log it.
+// Only reachable in FULL-DHT mode — proxy mode constructs no Dht at all — which is exactly the
+// mode the question is about (and the one SK-CLIENTMODE is meant to make cheaper).
+#ifdef __ANDROID__
+#include <android/log.h>
+#define SK_DHTSTATS(...) __android_log_print(ANDROID_LOG_ERROR, "SK-DHTSTATS", __VA_ARGS__)
+#else
+#define SK_DHTSTATS(...) do {} while (0)
+#endif
