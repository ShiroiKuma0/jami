+// SK-PUSHGET: issue the post-push full get() for one listener, sweep the old value set only if
+// that get actually succeeded, then release the in-flight slot and honour any coalesced push.
+// Does NOT acquire searchLock_ itself, so it is safe to call with or without the lock held; the
+// done-callback below runs on the client's own callback loop (get()'s donecb is queued into
+// callbacks_), which is where it takes searchLock_ — the same pattern the `exp` branch uses.
+void
+DhtProxyClient::pushGet(const InfoHash& key,
+                        size_t token,
+                        system_clock::time_point sendTime,
+                        CacheValueCallback cb,
+                        std::vector<Sp<Value>> oldValues)
+{
+    auto receivedIds = std::make_shared<std::set<Value::Id>>();
+    get(
+        key,
+        [cb, sendTime, receivedIds](const std::vector<Sp<Value>>& vals) {
+            for (const auto& v : vals)
+                receivedIds->insert(v->id);
+            return cb(vals, false, sendTime);
+        },
+        [this, key, token, cb, oldValues, sendTime, receivedIds](bool ok) {
+            // SK-PUSHGET (ok-guard): sweep ONLY on a successful get. Stock ignored `ok` and
+            // replayed oldValues as expired unconditionally, so a get that failed (non-200, no
+            // body, parse error) decremented every cached value with no compensating adds —
+            // erasing the listener's whole cache and reporting every value expired. On a presence
+            // key that is every contact going offline at once from one network blip, and this
+            // fork's watchdog triages wedges off exactly that signal.
+            //
+            // Residual, accepted deliberately: if the get failed *after* delivering some values,
+            // those adds are not undone, so their refcount sits one high and a later genuine
+            // expiry decrements 2->1 instead of removing. That is a missed expiration — strictly
+            // milder than the mass false-expiry it replaces. Undoing the partial adds instead
+            // would round-trip them as add-then-expire, i.e. exactly the presence blip this is
+            // meant to prevent, so it is not the better trade.
+            // opendht 4.4.0 narrowed this itself: expire only the values the fresh get did
+            // NOT return, rather than replaying the whole old set. Adopted here — it is
+            // strictly better than the blanket sweep and removes the missed-expiry residual
+            // the previous note described. The ok-guard below is the part that is still ours.
+            if (ok) {
+                std::vector<Sp<Value>> toExpire;
+                for (const auto& v : oldValues)
+                    if (receivedIds->find(v->id) == receivedIds->end())
+                        toExpire.emplace_back(v);
+                if (not toExpire.empty())
+                    cb(toExpire, true, sendTime);
+            }
+
+            CacheValueCallback ncb;
+            std::vector<Sp<Value>> nold;
+            system_clock::time_point nsend;
+            bool again = false;
+            {
+                std::lock_guard lock(searchLock_);
+                auto s = searches_.find(key);
+                if (s == searches_.end())
+                    return;
+                auto l = s->second.listeners.find(token);
+                if (l == s->second.listeners.end())
+                    return;
+                l->second.getInFlight = false;
+                if (l->second.getPending and not (l->second.opstate and l->second.opstate->stop)) {
+                    l->second.getPending = false;
+                    l->second.getInFlight = true;
+                    ncb = l->second.cb;
+                    nold = l->second.cache.getValues();
+                    nsend = l->second.pendingSendTime;
+                    again = true;
+                }
+            }
+            if (again)
+                pushGet(key, token, nsend, std::move(ncb), std::move(nold));
+        });
+}
