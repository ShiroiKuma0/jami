 void
+SwarmManager::setNodeAbsent(const NodeId& nodeId)
+{
+    // SK-ABSENTNODE: remove only from known_nodes — the bin maintainBuckets speculatively draws
+    // from. Deliberately NOT routing_table.deleteNode(), which also shutdownNode()s the socket.
+    //
+    // This used to go through setMobileNodes(), whose semantics changed underneath it: upstream's
+    // powerDRT work made a mobile entry a wake-up TARGET (an extra encrypted DHT put per commit
+    // announcement, conversation_module.cpp), and the vector<NodeId> overload now returns early
+    // once LEGACY_MOBILE_NODE_SUNSET (2026-10-01) passes, which would have made this a silent
+    // no-op. Removing the node directly expresses the original intent with neither side effect.
+    std::lock_guard lock(mutex);
+    // A live socket means the device is reachable whatever presence claims — leave it alone.
+    if (routing_table.hasNode(nodeId))
+        return;
+    routing_table.findBucket(nodeId)->removeKnownNode(nodeId);
+}
