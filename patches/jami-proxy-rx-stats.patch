+// SK-PROXYRX: what this account's DHT proxy client has received. The application's connection
+// watchdog decides on it, so it is a plain call and depends on no diagnostics switch. Empty when
+// the account has no proxy client (full DHT, or not started).
+std::map<std::string, std::string>
+getProxyRxStats(const std::string& accountId)
+{
+    auto s = dht::skProxyRxStats(accountId);
+    if (not s.found)
+        return {};
+    return {{"proxy", s.proxy},
+            {"lastRxAgeMs", std::to_string(s.lastRxAgeMs)},
+            {"listeners", std::to_string(s.listeners)},
+            {"pushRx", std::to_string(s.pushRx)},
+            {"rxLines", std::to_string(s.rxLines)}};
+}
